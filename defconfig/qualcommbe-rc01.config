CONFIG_TARGET_qualcommbe=y
CONFIG_TARGET_qualcommbe_ipq95xx=y
CONFIG_TARGET_qualcommbe_ipq95xx_DEVICE_xiaomi_be10000=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_USE_APK=y
CONFIG_DEVEL=y
CONFIG_CCACHE=y
CONFIG_INCLUDE_CONFIG=y
CONFIG_JSON_OVERVIEW_IMAGE_INFO=y
CONFIG_IMAGEOPT=y
CONFIG_VERSIONOPT=y
CONFIG_VERSION_DIST="ImmortalWrt-RC01"
CONFIG_VERSION_NUMBER="rc01-dev"
CONFIG_FEED_nikki=m
CONFIG_FEED_daede=m

# Preserve the native wired PPE and ath12k AP/DS implementation.
CONFIG_PACKAGE_kmod-qcom-ppe=y
CONFIG_PACKAGE_kmod-ath12k=y
CONFIG_ATH12K_THERMAL=y
CONFIG_PACKAGE_MAC80211_DEBUGFS=y
CONFIG_PACKAGE_ath12k-firmware-qcn9274-ddwrt=y
CONFIG_PACKAGE_ipq-wifi-xiaomi_be10000=y
CONFIG_PACKAGE_wpad-openssl=y
CONFIG_PACKAGE_rc01-platform=y
CONFIG_PACKAGE_kmod-hwmon-emc2305=y
CONFIG_PACKAGE_kmod-thermal=y
CONFIG_PACKAGE_fdt-utils=y
CONFIG_PACKAGE_uboot-envtools=y

# Stable Mihomo is built into SquashFS; credentials and subscriptions are not.
CONFIG_PACKAGE_mihomo-meta=y
CONFIG_PACKAGE_nikki=y
CONFIG_PACKAGE_luci-app-nikki=y
CONFIG_PACKAGE_luci-i18n-nikki-zh-cn=y
# CONFIG_PACKAGE_mihomo-alpha is not set
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl=y
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-app-router-tool=y
CONFIG_PACKAGE_luci-app-rc01=y
CONFIG_PACKAGE_luci-i18n-rc01-zh-cn=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_ca-certificates=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_tcpdump=y
# CONFIG_PACKAGE_tcpdump-mini is not set
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_zram-swap=y

# Match the AX6000's VPN tools without preconfiguring accounts or tunnels.
CONFIG_PACKAGE_kmod-wireguard=y
CONFIG_PACKAGE_wireguard-tools=y
CONFIG_PACKAGE_luci-proto-wireguard=y
CONFIG_PACKAGE_tailscale=y
CONFIG_PACKAGE_luci-app-tailscale-community=y
CONFIG_PACKAGE_luci-i18n-tailscale-community-zh-cn=y

# Native Qualcomm/RC01 inspection; none of these start traffic tests on boot.
CONFIG_PACKAGE_ethtool-full=y
# CONFIG_PACKAGE_ethtool is not set
CONFIG_PACKAGE_tc-full=y
# CONFIG_PACKAGE_tc-tiny is not set
# CONFIG_PACKAGE_tc-bpf is not set
CONFIG_PACKAGE_ip-bridge=y
CONFIG_PACKAGE_conntrack=y
CONFIG_PACKAGE_iw-full=y
# CONFIG_PACKAGE_iw is not set
CONFIG_PACKAGE_hostapd-utils=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_pciutils=y
CONFIG_PACKAGE_usbutils=y
CONFIG_PACKAGE_cpufreq=y
CONFIG_PACKAGE_luci-app-cpufreq=y
CONFIG_PACKAGE_luci-i18n-cpufreq-zh-cn=y

# Optional external data storage; no automount, formatting or extroot setup.
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_e2fsprogs=y

# No competing proxy/QoS daemon in the default image. The optional dae
# fragment supplies its complete BPF configuration when explicitly selected.
# CONFIG_PACKAGE_luci-app-homeproxy is not set
# CONFIG_PACKAGE_sing-box is not set
# CONFIG_PACKAGE_luci-app-openclash is not set
# CONFIG_PACKAGE_luci-app-passwall is not set
# CONFIG_PACKAGE_luci-app-passwall2 is not set
# CONFIG_PACKAGE_luci-app-daed is not set
# CONFIG_PACKAGE_daed is not set
# CONFIG_PACKAGE_daed-geoip is not set
# CONFIG_PACKAGE_daed-geosite is not set
# CONFIG_PACKAGE_dae is not set
# CONFIG_PACKAGE_luci-app-dae is not set
# CONFIG_PACKAGE_luci-app-daede is not set
# CONFIG_PACKAGE_irqbalance is not set
# CONFIG_PACKAGE_luci-app-qca-ppe-qos is not set
# CONFIG_PACKAGE_qca-ppe-qos is not set
# CONFIG_PACKAGE_qosify is not set
# CONFIG_PACKAGE_sqm-scripts is not set
# CONFIG_PACKAGE_samba4-server is not set
# CONFIG_PACKAGE_ksmbd-server is not set
# CONFIG_PACKAGE_luci-app-samba4 is not set
# CONFIG_PACKAGE_luci-app-upnp is not set
# CONFIG_PACKAGE_miniupnpd is not set
# CONFIG_PACKAGE_miniupnpd-nftables is not set
# CONFIG_PACKAGE_automount is not set
# CONFIG_PACKAGE_f2fs-tools is not set
# CONFIG_PACKAGE_kmod-fs-f2fs is not set
