+static void ath12k_ahb_quiesce(struct ath12k_base *ab)
+{
+	struct ath12k_ahb *ahb = ath12k_ab_to_ahb(ab);
+
+	if (ahb->root_pd_notifier)
+		ath12k_ahb_unregister_rproc_notifier(ab);
+	while (ahb->userpd_irqs_requested) {
+		int i = --ahb->userpd_irqs_requested;
+
+		devm_free_irq(ab->dev, ahb->userpd_irq_num[i], ab);
+	}
+}
+
+static void ath12k_ahb_free_data_irqs(struct ath12k_base *ab)
+{
+	struct ath12k_ahb *ahb = ath12k_ab_to_ahb(ab);
+	struct ath12k_ext_irq_grp *grp;
+	int i, j;
+
+	for (i = 0; i < ab->hw_params->ce_count; i++) {
+		if (!test_and_clear_bit(i, &ahb->ce_irqs_requested))
+			continue;
+		devm_free_irq(ab->dev, ab->irq_num[ATH12K_IRQ_CE0_OFFSET + i],
+			      &ab->ce.ce_pipe[i]);
+		cancel_work_sync(&ab->ce.ce_pipe[i].intr_wq);
+	}
+	for (i = 0; i < ATH12K_EXT_IRQ_GRP_NUM_MAX; i++) {
+		grp = &ab->ext_irq_grp[i];
+		while (grp->num_requested) {
+			j = --grp->num_requested;
+			devm_free_irq(ab->dev, ab->irq_num[grp->irqs[j]], grp);
+		}
+		if (!grp->napi_ndev)
+			continue;
+		if (grp->napi_enabled) {
+			napi_disable(&grp->napi);
+			grp->napi_enabled = false;
+		}
+		netif_napi_del(&grp->napi);
+		free_netdev(grp->napi_ndev);
+		grp->napi_ndev = NULL;
+	}
 }
 
