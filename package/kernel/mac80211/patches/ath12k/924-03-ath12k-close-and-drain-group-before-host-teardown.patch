+void ath12k_ce_deinit_pipes(struct ath12k_base *ab)
+{
+	struct ath12k_ce_ring *rings[3];
+	struct ath12k_ce_pipe *pipe;
+	int i, j;
+
+	for (i = 0; i < ab->hw_params->ce_count; i++) {
+		pipe = &ab->ce.ce_pipe[i];
+		rings[0] = pipe->src_ring;
+		rings[1] = pipe->dest_ring;
+		rings[2] = pipe->status_ring;
+		for (j = 0; j < ARRAY_SIZE(rings); j++) {
+			if (!rings[j] || !rings[j]->initialized)
+				continue;
+			ab->hal.srng_list[rings[j]->hal_ring_id].initialized = false;
+			rings[j]->initialized = false;
+		}
+	}
+}
