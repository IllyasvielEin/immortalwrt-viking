 {
+	unsigned long flags;
 	int i;
 
-	for (i = 0; i < irq_grp->num_irq; i++)
-		disable_irq_nosync(irq_grp->ab->irq_num[irq_grp->irqs[i]]);
+	spin_lock_irqsave(&irq_grp->irq_lock, flags);
+	if (irq_grp->irq_enabled) {
+		irq_grp->irq_enabled = false;
+		for (i = 0; i < irq_grp->num_irq; i++)
+			disable_irq_nosync(irq_grp->ab->irq_num[irq_grp->irqs[i]]);
+	}
+	spin_unlock_irqrestore(&irq_grp->irq_lock, flags);
 }
 
