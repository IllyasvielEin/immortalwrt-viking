 		ath12k_info(ab, "Booting in ftm mode\n");
@@ -885,26 +891,32 @@
 	}
 
 	ath12k_debugfs_soc_create(ab);
-
 	ret = ath12k_hif_power_up(ab);
 	if (ret) {
 		ath12k_err(ab, "failed to power up :%d\n", ret);
-		goto err_qmi_deinit;
-	}
-
+		ath12k_debugfs_soc_destroy(ab);
+		/* The group caller drops ag/core locks before stopping QMI work. */
+		return ret;
+	}
+
+	ab->soc_created = true;
 	return 0;
-
-err_qmi_deinit:
-	ath12k_debugfs_soc_destroy(ab);
-	ath12k_qmi_deinit_service(ab);
-	return ret;
 }
 
 static void ath12k_core_soc_destroy(struct ath12k_base *ab)
 {
-	ath12k_hif_power_down(ab, false);
-	ath12k_reg_free(ab);
-	ath12k_debugfs_soc_destroy(ab);
+	lockdep_assert_held(&ab->ag->mutex);
+
+	/* QMI and recovery work were stopped for every member before taking
+	 * the group lock. Partial create and repeated destroy are harmless.
+	 */
+	if (ab->soc_created) {
+		ath12k_hif_power_down(ab, false);
+		ath12k_reg_free(ab);
+		ath12k_debugfs_soc_destroy(ab);
+		ath12k_core_to_group_ref_put(ab);
+		ab->soc_created = false;
+	}
 	ath12k_qmi_deinit_service(ab);
 }
 
