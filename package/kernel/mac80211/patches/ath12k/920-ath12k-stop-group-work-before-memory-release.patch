+void ath12k_qmi_stop_service(struct ath12k_base *ab)
+{
+	struct ath12k_qmi *qmi = &ab->qmi;
+	struct ath12k_qmi_driver_event *event, *tmp;
+
+	lockdep_assert_not_held(&ab->ag->mutex);
+	spin_lock(&qmi->event_lock);
+	qmi->events_stopped = true;
+	spin_unlock(&qmi->event_lock);
+	if (qmi->handle_initialized) {
+		qmi_handle_release(&qmi->handle);
+		qmi->handle_initialized = false;
+	}
+	cancel_work_sync(&qmi->event_work);
+	if (qmi->event_wq) {
+		destroy_workqueue(qmi->event_wq);
+		qmi->event_wq = NULL;
+	}
+	spin_lock(&qmi->event_lock);
+	list_for_each_entry_safe(event, tmp, &qmi->event_list, list) {
+		list_del(&event->list);
+		kfree(event);
+	}
+	spin_unlock(&qmi->event_lock);
+}
