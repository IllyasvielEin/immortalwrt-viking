+			ath12k_core_hw_group_destroy(ag);
+			goto err_unassign;
+		}
+	}
 	mutex_unlock(&ag->mutex);
-
+	mutex_unlock(&ath12k_hw_group_mutex);
 	return 0;
 
-err_unassign_hw_group:
+err_unassign:
 	ath12k_core_hw_group_unassign(ab);
-err_unregister_notifier:
