-static bool ath12k_regdom_changes(struct ieee80211_hw *hw, char *alpha2)
-{
-	const struct ieee80211_regdomain *regd;
-
-	regd = rcu_dereference_rtnl(hw->wiphy->regd);
-	/* This can happen during wiphy registration where the previous
-	 * user request is received before we update the regd received
-	 * from firmware.
+/* This is an attempt cache, never a firmware acknowledgment. */
+#define ATH12K_REG_DOUBT (-1)
+#define ATH12K_REG_USER_ONLY 0x10000
+
+void ath12k_reg_doubt_locked(struct ath12k_base *ab)
+{
+	struct ath12k *ar;
+	int i;
+
+	lockdep_assert_held(&ab->base_lock);
+	if (ab->reg_events_stopped)
+		return;
+	for (i = 0; i < ab->num_radios; i++) {
+		ar = ab->pdevs[i].ar;
+		if (ar && ar->ah)
+			atomic_set(&ar->ah->reg_user_country, ATH12K_REG_DOUBT);
+	}
+}
+
+void ath12k_reg_doubt(struct ath12k_base *ab)
+{
+	spin_lock_bh(&ab->base_lock);
+	ath12k_reg_doubt_locked(ab);
+	spin_unlock_bh(&ab->base_lock);
+}
+
+static bool ath12k_reg_user_skip(struct ath12k_hw *ah, const char *alpha2)
+{
+	int old, next = ATH12K_REG_USER_ONLY |
+			(u8)alpha2[0] << 8 | (u8)alpha2[1];
+
+	old = atomic_read(&ah->reg_user_country);
+	for (;;) {
+		if (old == ATH12K_REG_DOUBT)
+			return false;
+		/* Even a same-value hit must lose to concurrent DOUBT. */
+		if (atomic_try_cmpxchg(&ah->reg_user_country, &old, next))
+			return old == next;
+	}
+}
+
+bool ath12k_reg_sender_get(struct ath12k_base *ab)
+{
+	bool admitted;
+
+	spin_lock_bh(&ab->base_lock);
+	admitted = !ab->reg_events_stopped;
+	if (admitted)
+		ab->reg_senders++;
+	spin_unlock_bh(&ab->base_lock);
+	return admitted;
+}
+
+void ath12k_reg_sender_put(struct ath12k_base *ab)
+{
+	spin_lock_bh(&ab->base_lock);
+	if (WARN_ON(!ab->reg_senders)) {
+		spin_unlock_bh(&ab->base_lock);
+		return;
+	}
+	if (!--ab->reg_senders)
+		wake_up_all(&ab->reg_senders_wait);
+	spin_unlock_bh(&ab->base_lock);
+}
+
+static bool ath12k_reg_senders_idle(struct ath12k_base *ab)
+{
+	bool idle;
+
+	spin_lock_bh(&ab->base_lock);
+	idle = !ab->reg_senders;
+	spin_unlock_bh(&ab->base_lock);
+	return idle;
+}
+
+static struct ath12k *ath12k_reg_source(struct ath12k_hw *ah)
+{
+	struct ath12k *ar;
+	int i;
+
+	if (!ah->num_radio)
+		return NULL;
+	for_each_ar(ah, ar, i)
+		if (ar->supports_6ghz)
+			return ar;
+	return ath12k_ah_to_ar(ah, 0);
+}
+
+void ath12k_reg_events_close(struct ath12k_base *ab)
+{
+	spin_lock_bh(&ab->base_lock);
+	ath12k_reg_doubt_locked(ab);
+	ab->reg_events_stopped = true;
+	spin_unlock_bh(&ab->base_lock);
+}
+
+/* The owner must close ALL members before draining ANY, and fix their lifetime.
+ * No ag/core/RTNL/wiphy/hw_mutex/base_lock may be held by the caller.
+ */
+void ath12k_reg_events_drain(struct ath12k_base *ab)
+{
+	struct ath12k_wmi_scan_chan_list_arg *arg, *tmp;
+	struct ath12k *ar;
+	LIST_HEAD(discard);
+	int i;
+
+	cancel_work_sync(&ab->update_11d_work);
+	wait_event(ab->reg_senders_wait, ath12k_reg_senders_idle(ab));
+	for (i = 0; i < ab->num_radios; i++) {
+		ar = ab->pdevs[i].ar;
+		if (!ar || !ar->reg_work_initialized)
+			continue;
+		cancel_work_sync(&ar->regd_update_work);
+		cancel_work_sync(&ar->regd_channel_update_work);
+		spin_lock_bh(&ar->data_lock);
+		list_splice_tail_init(&ar->regd_channel_update_queue, &discard);
+		spin_unlock_bh(&ar->data_lock);
+		list_for_each_entry_safe(arg, tmp, &discard, list) {
+			list_del(&arg->list);
+			kfree(arg);
+		}
+	}
+}
+
+int ath12k_reg_events_open(struct ath12k_base *ab)
+{
+	struct ath12k *ar;
+	int i;
+
+	spin_lock_bh(&ab->base_lock);
+	if (test_bit(ATH12K_FLAG_UNREGISTERING, &ab->dev_flags)) {
+		spin_unlock_bh(&ab->base_lock);
+		return -ESHUTDOWN;
+	}
+	ab->reg_events_stopped = false;
+	/* Recovery BOOT installs new_regd, READY repeats open after clearing
+	 * is_reset under this lock. Neither open resets init nor DOUBT.
 	 */
-	if (!regd)
-		return true;
-
-	return memcmp(regd->alpha2, alpha2, 2) != 0;
+	if (test_bit(ATH12K_FLAG_REGISTERED, &ab->dev_flags) && !ab->is_reset)
+		for (i = 0; i < ab->num_radios; i++) {
+			ar = ab->pdevs[i].ar;
+			if (ar && ar->reg_work_initialized &&
+			    (ab->new_regd[i] || ab->default_regd[i]))
+				queue_work(system_unbound_wq, &ar->regd_update_work);
+		}
+	spin_unlock_bh(&ab->base_lock);
+	return 0;
 }
 
