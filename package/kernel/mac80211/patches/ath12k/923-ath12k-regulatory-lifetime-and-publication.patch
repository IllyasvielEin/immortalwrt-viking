+static bool ath12k_reg_wmm_equal(const struct ieee80211_wmm_ac *a,
+				 const struct ieee80211_wmm_ac *b)
+{
+	return a->cw_min == b->cw_min && a->cw_max == b->cw_max &&
+	       a->cot == b->cot && a->aifsn == b->aifsn;
+}
+
+static bool ath12k_reg_equal(const struct ieee80211_regdomain *a,
+			     const struct ieee80211_regdomain *b)
+{
+	const struct ieee80211_reg_rule *x, *y;
+	u32 i;
+	int ac;
+
+	if (!a || a->n_reg_rules != b->n_reg_rules ||
+	    memcmp(a->alpha2, b->alpha2, 2) || a->dfs_region != b->dfs_region)
+		return false;
+	for (i = 0; i < a->n_reg_rules; i++) {
+		x = &a->reg_rules[i];
+		y = &b->reg_rules[i];
+		if (x->freq_range.start_freq_khz != y->freq_range.start_freq_khz ||
+		    x->freq_range.end_freq_khz != y->freq_range.end_freq_khz ||
+		    x->freq_range.max_bandwidth_khz != y->freq_range.max_bandwidth_khz ||
+		    x->power_rule.max_antenna_gain != y->power_rule.max_antenna_gain ||
+		    x->power_rule.max_eirp != y->power_rule.max_eirp ||
+		    x->flags != y->flags || x->dfs_cac_ms != y->dfs_cac_ms ||
+		    x->has_wmm != y->has_wmm || x->psd != y->psd)
+			return false;
+		if (!x->has_wmm)
+			continue;
+		for (ac = 0; ac < IEEE80211_NUM_ACS; ac++)
+			if (!ath12k_reg_wmm_equal(&x->wmm_rule.client[ac],
+						  &y->wmm_rule.client[ac]) ||
+			    !ath12k_reg_wmm_equal(&x->wmm_rule.ap[ac],
+						  &y->wmm_rule.ap[ac]))
+				return false;
+	}
+	return true;
