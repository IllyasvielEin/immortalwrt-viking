-static void ath12k_qmi_free_target_mem_chunk(struct ath12k_base *ab)
+/* A firmware can already use an MLO view before core_start increments
+ * num_started. Keep that borrower distinct from the core-start lifetime.
+ */
+static void ath12k_qmi_put_mlo_mem_ref(struct ath12k_base *ab)
+{
+	struct ath12k_hw_group *ag = ab->ag;
+
+	lockdep_assert_held(&ag->mutex);
+	if (!ab->qmi.mlo_mem_ref)
+		return;
+
+	ab->qmi.mlo_mem_ref = false;
+	if (WARN_ON_ONCE(!ag->mlo_mem.num_users))
+		return;
+	ag->mlo_mem.num_users--;
+}
+
+static void ath12k_qmi_get_mlo_mem_ref(struct ath12k_base *ab)
+{
+	struct ath12k_hw_group *ag = ab->ag;
+
+	lockdep_assert_held(&ag->mutex);
+	if (ab->qmi.mlo_mem_ref)
+		return;
+
+	ab->qmi.mlo_mem_ref = true;
+	ag->mlo_mem.num_users++;
+}
+
+static void ath12k_qmi_release_mlo_mem(struct ath12k_base *ab)
 {
 	struct ath12k_hw_group *ag = ab->ag;
 	struct target_mem_chunk unused = {};
-	int i, mlo_idx;
+	int i;
+
+	lockdep_assert_held(&ag->mutex);
+	if (!ag->mlo_mem.init_done || ag->num_started || ag->mlo_mem.num_users)
+		return;
+
+	for (i = 0; i < ARRAY_SIZE(ag->mlo_mem.chunk); i++)
+		ath12k_qmi_free_mlo_mem_chunk(ab, &unused, i);
+	ag->mlo_mem.init_done = false;
+	ag->mlo_mem.mlo_mem_size = 0;
+	ag->mlo_mem.fixed_mem = false;
+	put_device(ag->mlo_mem.alloc_dev);
+	ag->mlo_mem.alloc_dev = NULL;
+}
+
+static int ath12k_qmi_begin_mlo_request(struct ath12k_base *ab)
+{
+	struct ath12k_hw_group *ag = ab->ag;
+	u32 total_size = 0;
+	int i;
+
+	lockdep_assert_held(&ag->mutex);
+	for (i = 0; i < ab->qmi.mem_seg_count; i++) {
+		if (ab->qmi.target_mem[i].type != MLO_GLOBAL_MEM_REGION_TYPE)
+			continue;
+		if (ab->qmi.target_mem[i].size > U32_MAX - total_size)
+			return -EINVAL;
+		total_size += ab->qmi.target_mem[i].size;
+	}
+	if (total_size > INT_MAX)
+		return -EINVAL;
+
+	/* This request replaces this device's previous views. A failed request
+	 * drops only this borrower; another partner's pre-start views stay live.
+	 */
+	ath12k_qmi_put_mlo_mem_ref(ab);
+	if (ag->mlo_mem.mlo_mem_size && total_size != ag->mlo_mem.mlo_mem_size) {
+		if (ag->mlo_mem.num_users || ag->num_started)
+			return -EINVAL;
+		ath12k_qmi_release_mlo_mem(ab);
+	}
+
+	return 0;
+}
+
+static void ath12k_qmi_free_target_mem_chunk(struct ath12k_base *ab)
+{
+	struct ath12k_hw_group *ag = ab->ag;
+	struct target_mem_chunk *chunk;
+	int i;
 
 	lockdep_assert_held(&ag->mutex);
 	for (i = 0; i < ARRAY_SIZE(ab->qmi.fixed_mem); i++)
 		ath12k_qmi_unmap_fixed_mem(ab, &ab->qmi.fixed_mem[i]);
 
-	for (i = 0, mlo_idx = 0; i < ab->qmi.mem_seg_count; i++) {
-		if (ab->qmi.target_mem[i].type == MLO_GLOBAL_MEM_REGION_TYPE) {
-			if (ab->qmi.target_mem[i].paddr)
-				ath12k_qmi_free_mlo_mem_chunk(ab,
-							      &ab->qmi.target_mem[i],
-							      mlo_idx);
-			mlo_idx++;
-		} else {
-			if (test_bit(ATH12K_FLAG_FIXED_MEM_REGION, &ab->dev_flags)) {
-				ab->qmi.target_mem[i].v.ioaddr = NULL;
-			} else {
-				if (!ab->qmi.target_mem[i].v.addr)
-					continue;
-				dma_free_coherent(ab->dev,
-						  ab->qmi.target_mem[i].prev_size,
-						  ab->qmi.target_mem[i].v.addr,
-						  ab->qmi.target_mem[i].paddr);
-				ab->qmi.target_mem[i].v.addr = NULL;
-			}
-		}
-	}
-
-	if (!ag->num_started && ag->mlo_mem.init_done) {
-		/* A shorter request may no longer contain an MLO view. Release by
-		 * group ownership, never by the new request's segment count.
-		 */
-		for (i = 0; i < ARRAY_SIZE(ag->mlo_mem.chunk); i++)
-			ath12k_qmi_free_mlo_mem_chunk(ab, &unused, i);
-		ag->mlo_mem.init_done = false;
-		ag->mlo_mem.mlo_mem_size = 0;
-		ag->mlo_mem.fixed_mem = false;
-		ag->mlo_mem.alloc_dev = NULL;
-	}
+	for (i = 0; i < ARRAY_SIZE(ab->qmi.target_mem); i++) {
+		chunk = &ab->qmi.target_mem[i];
+		ath12k_qmi_free_dma_chunk(ab, chunk);
+		chunk->v.addr = NULL;
+		chunk->paddr = 0;
+		chunk->dma_allocated = false;
+	}
+
+	ath12k_qmi_put_mlo_mem_ref(ab);
+	ath12k_qmi_release_mlo_mem(ab);
 }
 
