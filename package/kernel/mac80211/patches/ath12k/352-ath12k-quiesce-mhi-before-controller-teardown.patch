From: ViKing <viking.yfy@qq.com>
Date: Fri, 06 Nov 2026 16:38:10 +0800
Subject: [PATCH] wifi: ath12k: quiesce recovery and MHI on teardown

Firmware recovery powers MHI up before the data path sets PCI INIT_DONE.
Removing the device in that window skips PCI power-down and leaves the
QRTR channel device registered after its MHI channel storage is freed.
A later QRTR broadcast, for example while removing a companion AHB radio,
then dereferences that freed storage in mhi_queue_skb().

Use the MHI preparation state to decide whether PCI power-down is needed.
Also quiesce MHI at its final controller unregister, and make repeated or
partially initialized stops safe by checking the existing MHI state bits.
Keep the data-path INIT_DONE flag and the suspend keep-device path intact.

A concurrent FW_READY event can also queue restart_work while PCI removal
is destroying the radio. Drain QMI events and restart work before the
device teardown, and reject FW_READY once unregistering starts. This
prevents the restart worker from unregistering thermal/hwmon twice. Apply
the same event-before-restart drain order to AHB removal.

Signed-off-by: ViKing <viking.yfy@qq.com>

Local follow-up: snapshot the entry QMI failure state, then unregister and
drain reset/QMI/restart/dump work before either PCI remove branch.
QMI_FAIL is set only by the initialized QMI event worker; late
QMI service teardown alone cannot quiesce recovery before power-down.
This closes the original patch's QMI_FAIL early-exit gap.
---
--- a/drivers/net/wireless/ath/ath12k/pci.c
+++ b/drivers/net/wireless/ath/ath12k/pci.c
@@ -1483,7 +1483,10 @@
 {
 	struct ath12k_pci *ab_pci = ath12k_pci_priv(ab);
 
-	if (!test_bit(ATH12K_PCI_FLAG_INIT_DONE, &ab_pci->flags))
+	/* MHI can be live before the data path has started, including
+	 * while firmware recovery is bringing the controller back up.
+	 */
+	if (!test_bit(ATH12K_MHI_INIT, &ab_pci->mhi_state))
 		return;
 
 	/* restore aspm in case firmware bootup fails */
@@ -1712,18 +1715,27 @@
 {
 	struct ath12k_base *ab = pci_get_drvdata(pdev);
 	struct ath12k_pci *ab_pci = ath12k_pci_priv(ab);
+	bool qmi_fail;
 
 	ath12k_pci_set_irq_affinity_hint(ab_pci, NULL);
 
-	if (test_bit(ATH12K_FLAG_QMI_FAIL, &ab->dev_flags)) {
+	/* Keep the entry decision stable while draining a running QMI event. */
+	qmi_fail = test_bit(ATH12K_FLAG_QMI_FAIL, &ab->dev_flags);
+	set_bit(ATH12K_FLAG_UNREGISTERING, &ab->dev_flags);
+
+	cancel_work_sync(&ab->reset_work);
+	/* Drain FW_READY before the recovery worker can restart. */
+	cancel_work_sync(&ab->qmi.event_work);
+	cancel_work_sync(&ab->restart_work);
+	cancel_work_sync(&ab->dump_work);
+
+	/* QMI failure can leave events/recovery live too. Quiesce them before
+	 * power-down or group teardown, not only on the normal remove path.
+	 */
+	if (qmi_fail) {
 		ath12k_pci_power_down(ab, false);
 		goto qmi_fail;
 	}
-
-	set_bit(ATH12K_FLAG_UNREGISTERING, &ab->dev_flags);
-
-	cancel_work_sync(&ab->reset_work);
-	cancel_work_sync(&ab->dump_work);
 	ath12k_core_hw_group_cleanup(ab->ag);
 
 qmi_fail:
--- a/drivers/net/wireless/ath/ath12k/mhi.c
+++ b/drivers/net/wireless/ath/ath12k/mhi.c
@@ -288,6 +288,8 @@
 {
 	struct mhi_controller *mhi_ctrl = ab_pci->mhi_ctrl;
 
+	/* Remove channel devices before freeing their controller storage. */
+	ath12k_mhi_stop(ab_pci, false);
 	mhi_unregister_controller(mhi_ctrl);
 	kfree(mhi_ctrl->irq);
 	mhi_free_controller(mhi_ctrl);
@@ -513,12 +515,15 @@
 	 * workaround, otherwise ath12k_core_resume() will timeout
 	 * during resume.
 	 */
-	if (is_suspend)
-		ath12k_mhi_set_state(ab_pci, ATH12K_MHI_POWER_OFF_KEEP_DEV);
-	else
-		ath12k_mhi_set_state(ab_pci, ATH12K_MHI_POWER_OFF);
-
-	ath12k_mhi_set_state(ab_pci, ATH12K_MHI_DEINIT);
+	if (test_bit(ATH12K_MHI_POWER_ON, &ab_pci->mhi_state)) {
+		if (is_suspend)
+			ath12k_mhi_set_state(ab_pci, ATH12K_MHI_POWER_OFF_KEEP_DEV);
+		else
+			ath12k_mhi_set_state(ab_pci, ATH12K_MHI_POWER_OFF);
+	}
+
+	if (test_bit(ATH12K_MHI_INIT, &ab_pci->mhi_state))
+		ath12k_mhi_set_state(ab_pci, ATH12K_MHI_DEINIT);
 }
 
 void ath12k_mhi_suspend(struct ath12k_pci *ab_pci)
--- a/drivers/net/wireless/ath/ath12k/qmi.c
+++ b/drivers/net/wireless/ath/ath12k/qmi.c
@@ -4469,6 +4469,9 @@
 				set_bit(ATH12K_FLAG_QMI_FAIL, &ab->dev_flags);
 			break;
 		case ATH12K_QMI_EVENT_FW_READY:
+			if (test_bit(ATH12K_FLAG_UNREGISTERING, &ab->dev_flags))
+				break;
+
 			clear_bit(ATH12K_FLAG_QMI_FAIL, &ab->dev_flags);
 			if (test_bit(ATH12K_FLAG_QMI_FW_READY_COMPLETE, &ab->dev_flags)) {
 				if (ab->is_reset)
--- a/drivers/net/wireless/ath/ath12k/ahb.c
+++ b/drivers/net/wireless/ath/ath12k/ahb.c
@@ -1376,8 +1376,8 @@
 	}
 
 	set_bit(ATH12K_FLAG_UNREGISTERING, &ab->dev_flags);
+	cancel_work_sync(&ab->qmi.event_work);
 	cancel_work_sync(&ab->restart_work);
-	cancel_work_sync(&ab->qmi.event_work);
 }
 
 static void ath12k_ahb_free_resources(struct ath12k_base *ab)
