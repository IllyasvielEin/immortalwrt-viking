+bool ath12k_qmi_generation_current(struct ath12k_qmi *qmi, u64 gen)
+{
+	bool is_current;
+
+	spin_lock(&qmi->event_lock);
+	is_current = !qmi->events_stopped && qmi->server_present &&
+		  qmi->server_gen == gen;
+	spin_unlock(&qmi->event_lock);
+	return is_current;
+}
