+	spin_lock(&qmi->event_lock);
+	is_current = !qmi->events_stopped && qmi->server_present &&
+		qmi->lookup_sq.sq_node == sq->sq_node &&
+		qmi->lookup_sq.sq_port == sq->sq_port;
+	spin_unlock(&qmi->event_lock);
+	return is_current;
+}
