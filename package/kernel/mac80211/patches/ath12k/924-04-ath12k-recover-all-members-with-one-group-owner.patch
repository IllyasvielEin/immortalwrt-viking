+		ath12k_reg_events_close(ab);
+		ath12k_qmi_close(ab);
+	}
+}
+
+static void ath12k_core_recovery_drain(struct ath12k_hw_group *ag)
+{
+	struct ath12k_base *ab;
+	int i;
+
+	ath12k_dp_ds_stop_group(ag);
+	for (i = 0; i < ag->num_devices; i++) {
+		ab = ag->ab[i];
+		if (!ab)
+			continue;
+		ath12k_qmi_drain(ab);
+		cancel_work_sync(&ab->restart_work);
+		/* No reset_work cancellation: the owner is one of those works. */
+		flush_work(&ab->dump_work);
+		ath12k_reg_events_drain(ab);
+		ath12k_core_mac_delivery_close(ab);
+		ath12k_hif_irq_disable(ab);
+	}
+}
+
+static int ath12k_core_recovery_stop(struct ath12k_hw_group *ag)
+{
+	struct ath12k_base *ab;
+	int i, ret = 0;
+
+	ath12k_dp_ds_stop_group(ag);
+	mutex_lock(&ag->mutex);
+	if (ath12k_core_recovery_exiting(ag)) {
+		mutex_unlock(&ag->mutex);
+		return -ESHUTDOWN;
+	}
+	for (i = 0; i < ag->num_devices; i++) {
+		ab = ag->ab[i];
+		if (!ab)
+			continue;
+		mutex_lock(&ab->core_lock);
+		ath12k_core_pdev_destroy(ab);
+		ath12k_core_stop(ab);
+		/* Partial/pre-start bundles have no core_live, but still owe
+		 * DP cleanup. Refusal preserves the independently recorded debt.
+		 */
+		if (ab->dp_live)
+			ab->dp_live = !ath12k_dp_cmn_device_deinit(ath12k_ab_to_dp(ab));
+		if (ab->dp_live)
+			ret = -EIO;
+		ath12k_core_to_group_ref_put(ab);
+		mutex_unlock(&ab->core_lock);
+	}
+	mutex_unlock(&ag->mutex);
+	for (i = 0; i < ag->num_devices; i++) {
+		ab = ag->ab[i];
+		if (!ab)
+			continue;
+		if (ab->powered) {
+			ath12k_hif_power_down(ab, false);
+			ab->powered = false;
+		}
+		/* Transport callback barrier (MHI power-down) precedes release.
+		 * All old txn users drained; no memset of retained target/M3/aux.
+		 */
+		ath12k_qmi_release(ab);
+		if (!ab->dp_live)
+			ath12k_hal_srng_deinit(ab);
+	}
+	if (test_bit(ATH12K_GROUP_FLAG_DS_QUARANTINED, &ag->flags))
+		ret = -EIO;
+	return ret;
+}
