+static void ath12k_core_reset(struct work_struct *work)
+{
+	struct ath12k_base *owner = container_of(work, struct ath12k_base, reset_work);
+	struct ath12k_hw_group *ag = owner->ag;
+	struct ath12k_base *ab;
+	struct ath12k_hw *ah;
+	unsigned long deadline, left;
+	int i, ret = 0, total_vdev;
+
+	/* Selection comes before ANY wait or destructive operation. Exit's
+	 * lifecycle lock pins membership while it joins this owner, so the
+	 * owner never needs (and must never take) that lifecycle lock.
+	 */
+	mutex_lock(&ag->mutex);
+	if (ath12k_core_recovery_exiting(ag))
+		goto unlock_return;
+	if (ag->recovery_state != ATH12K_GROUP_RECOVERY_IDLE) {
+		if (ag->recovery_state == ATH12K_GROUP_RECOVERY_BOOT)
+			ath12k_core_recovery_error(owner, -EIO);
+		goto unlock_return;
+	}
+	ag->recovery_state = ATH12K_GROUP_RECOVERY_DRAIN;
+	ag->recovery_owner = owner;
+	ag->recovery_error = 0;
+	ag->boot_ready = false;
+	ath12k_core_recovery_close(ag);
+	for (i = 0; i < ag->num_devices; i++) {
+		ab = ag->ab[i];
+		if (!ab)
+			continue;
+		spin_lock_bh(&ab->base_lock);
+		ab->is_reset = true;
+		spin_unlock_bh(&ab->base_lock);
+		set_bit(ATH12K_FLAG_CRASH_FLUSH, &ab->dev_flags);
+		set_bit(ATH12K_FLAG_RECOVERY, &ab->dev_flags);
+	}
+	mutex_unlock(&ag->mutex);
+	ath12k_core_recovery_drain(ag);
+	if (ath12k_core_recovery_exiting(ag))
+		return;
+
+	/* Existing HIF coredump operations use bounded transport waits. All
+	 * allocation writers are drained before reading shared target memory.
+	 */
+	for (i = 0; i < ag->num_devices; i++) {
+		ab = ag->ab[i];
+		if (ab && ab->powered) {
+			ath12k_coredump_collect(ab);
+			flush_work(&ab->dump_work);
+		}
+	}
+	ath12k_core_pre_reconfigure_recovery(owner);
+	ath12k_core_post_reconfigure_recovery(owner);
+	ret = ath12k_core_recovery_stop(ag);
+	if (ret)
+		goto failed;
+
+	mutex_lock(&ag->mutex);
+	if (ath12k_core_recovery_exiting(ag))
+		goto unlock_return;
+	/* Detach ALL old views, including pre-start borrowers, before any
+	 * memset of the shared pool. Non-MLO allocation metadata survives.
+	 */
+	for (i = 0; i < ag->num_devices; i++)
+		if (ag->ab[i])
+			ath12k_qmi_detach_mlo_mem(ag->ab[i]);
+	if (WARN_ON(ag->num_started || ag->mlo_mem.num_users)) {
+		mutex_unlock(&ag->mutex);
+		ret = -EBUSY;
+		goto failed;
+	}
+	ath12k_qmi_reset_mlo_mem(ag);
+	ag->recovery_state = ATH12K_GROUP_RECOVERY_BOOT;
+	mutex_unlock(&ag->mutex);
+	/* One fixed deadline includes stale lookup timeout and normal boot.
+	 * Soft transport failure never extends it or becomes reset success.
+	 */
+	deadline = jiffies + ATH12K_RESET_TIMEOUT_HZ +
+		msecs_to_jiffies(ATH12K_QMI_WLANFW_TIMEOUT_MS);
+	for (i = 0; i < ag->num_devices; i++) {
+		ab = ag->ab[i];
+		if (!ab)
+			continue;
+		if (ath12k_core_recovery_exiting(ag))
+			return;
+		ret = ath12k_hal_srng_init(ab);
+		if (ret)
+			goto failed;
+		total_vdev = ab->num_radios * TARGET_NUM_VDEVS(ab);
+		ab->free_vdev_map = (1ULL << total_vdev) - 1;
+		ab->free_vdev_stats_id_map = 0;
+		mutex_lock(&ag->mutex);
+		if (ath12k_core_recovery_exiting(ag))
+			goto unlock_return;
+		ret = ath12k_qmi_reopen_service(ab);
+		if (ret) {
+			mutex_unlock(&ag->mutex);
+			goto failed;
+		}
+		/* Claim partial power-up too: failed MHI boot still needs stop. */
+		ab->powered = true;
+		ret = ath12k_hif_power_up(ab);
+		mutex_unlock(&ag->mutex);
+		if (ret)
+			goto failed;
+		if (READ_ONCE(ag->recovery_error)) {
+			ret = READ_ONCE(ag->recovery_error);
+			goto failed;
+		}
+	}
+	left = time_before(jiffies, deadline) ? deadline - jiffies : 0;
+	if (!left || !wait_event_timeout(ag->recovery_wait,
+		ath12k_core_recovery_exiting(ag) || READ_ONCE(ag->recovery_error) ||
+		READ_ONCE(ag->boot_ready), left)) {
+		ret = -ETIMEDOUT;
+		goto failed;
+	}
+	mutex_lock(&ag->mutex);
+	if (ath12k_core_recovery_exiting(ag))
+		goto unlock_return;
+	ret = READ_ONCE(ag->recovery_error);
+	if (ret || !ag->boot_ready) {
+		mutex_unlock(&ag->mutex);
+		goto failed;
+	}
+	for (i = 0; i < ag->num_devices; i++) {
+		ab = ag->ab[i];
+		if (!ab)
+			continue;
+		if (WARN_ON(!ab->core_live || !ab->pdev_live)) {
+			ret = -EIO;
+			break;
+		}
+	}
+	if (ret) {
+		mutex_unlock(&ag->mutex);
