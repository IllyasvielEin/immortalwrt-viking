#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-or-later

# Runs the RGB service only when rc01_rgb.main.enabled=1 (default 0) and
# system leds_off is not set. It then owns red/green/blue:ambient; no other
# LED is touched. Stopped or killed, the bar is off unless another controller
# (a system LED section, a trigger or a direct brightness write) took it over.
# Starts after /etc/init.d/led (START=96).
START=97
STOP=10
USE_PROCD=1

RC01_RGB_LEDS="red:ambient green:ambient blue:ambient"
RC01_RGB_SYSFS="${RC01_SYSFS:-/sys}"
RC01_RGB_STATUS="${RC01_ROOT:-}/var/run/rc01-rgb.status"
RC01_RGB_DAEMON="${RC01_RGB_DAEMON:-/usr/libexec/rc01-rgb}"
# procd sends SIGTERM, then SIGKILL after this many seconds.
RC01_RGB_TERM_TIMEOUT=5
RC01_RGB_WAIT="${RC01_RGB_WAIT:-$((RC01_RGB_TERM_TIMEOUT + 2))}"

# A single system LED declaration reserves the whole colour group.
rc01_rgb_reserved() {
	local sysfs led
	config_get sysfs "$1" sysfs
	for led in $RC01_RGB_LEDS; do
		[ "$sysfs" != "$led" ] || RC01_RGB_RESERVED=1
	done
	return 0
}

rc01_rgb_system_owned() {
	RC01_RGB_RESERVED=0
	config_load system
	config_foreach rc01_rgb_reserved led
	[ "$RC01_RGB_RESERVED" = 1 ]
}

# Another controller's active trigger on any channel keeps the whole bar.
rc01_rgb_triggered() {
	local led trigger
	for led in $RC01_RGB_LEDS; do
		trigger="$(cat "$RC01_RGB_SYSFS/class/leds/$led/trigger" 2>/dev/null)"
		case "$trigger" in ''|none|*'[none]'*) ;; *) return 0 ;; esac
	done
	return 1
}

rc01_rgb_off() {
	local led
	for led in $RC01_RGB_LEDS; do
		[ -w "$RC01_RGB_SYSFS/class/leds/$led/brightness" ] &&
			echo 0 > "$RC01_RGB_SYSFS/class/leds/$led/brightness"
	done
	return 0
}

start_service() {
	local enabled led
	config_load rc01_rgb
	config_get_bool enabled main enabled 0
	[ "$enabled" = 1 ] || return 0
	[ "$(uci -q get system.@system[-1].leds_off)" = 1 ] && return 0
	! rc01_rgb_system_owned || {
		logger -t rc01-rgb 'RGB LED configured in system; leaving it alone'
		return 0
	}
	for led in $RC01_RGB_LEDS; do
		[ -e "$RC01_RGB_SYSFS/class/leds/$led/brightness" ] || {
			logger -t rc01-rgb "LED $led not found; RGB service not started"
			return 0
		}
	done
	procd_open_instance
	procd_set_param command "$RC01_RGB_DAEMON"
	procd_set_param term_timeout "$RC01_RGB_TERM_TIMEOUT"
	# Settings are read at start: a changed config restarts the instance.
	procd_set_param file /etc/config/rc01_rgb
	procd_set_param respawn 3600 5 5
	procd_set_param stderr 1
	procd_close_instance
}

rc01_rgb_status_pid() {
	sed -n 's/.*"pid": *\([0-9][0-9]*\).*/\1/p' "$RC01_RGB_STATUS" 2>/dev/null
}

# True while that PID is still this service's daemon (not a reused PID).
rc01_rgb_running() {
	case "$(tr '\0' ' ' < "/proc/$1/cmdline" 2>/dev/null)" in
		*"$RC01_RGB_DAEMON"*) return 0 ;;
	esac
	return 1
}

# rc.common calls this right after procd_kill returns: procd has only sent
# SIGTERM (SIGKILL follows after term_timeout), so the instance is usually
# still running here. On a normal exit, and when it yields the bar to another
# controller, the instance turns off the channels it still owns and removes
# its status file. Wait for the instance named in that file to exit first.
# Only a status file that survives its own instance means the bar was left
# lit by a killed owner; an instance that is still alive keeps its LEDs.
service_stopped() {
	local pid left="$RC01_RGB_WAIT"
	pid="$(rc01_rgb_status_pid)"
	[ -n "$pid" ] || return 0
	while rc01_rgb_running "$pid"; do
		[ "$left" -gt 0 ] || return 0
		sleep 1
		left=$((left - 1))
	done
	# Gone. A later instance would have written its own PID.
	[ "$(rc01_rgb_status_pid)" = "$pid" ] || return 0
	rm -f "$RC01_RGB_STATUS"
	rc01_rgb_system_owned || rc01_rgb_triggered || rc01_rgb_off
}

service_triggers() {
	procd_add_reload_trigger rc01_rgb system
}
