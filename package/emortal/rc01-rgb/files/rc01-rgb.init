#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-or-later

# Runs the RGB service only when rc01_rgb.main.enabled=1 (default 0) and
# system leds_off is not set. It then owns red/green/blue:ambient; no other
# LED is touched. Stopped or killed, the bar is off unless another controller
# (a system LED section, a trigger or a direct brightness write) took it over.
# Starts after /etc/init.d/led (START=96).
START=97
STOP=10
USE_PROCD=1

RC01_RGB_LEDS="red:ambient green:ambient blue:ambient"
RC01_RGB_SYSFS="${RC01_SYSFS:-/sys}"
RC01_RGB_STATUS="${RC01_ROOT:-}/var/run/rc01-rgb.status"

# A single system LED declaration reserves the whole colour group.
rc01_rgb_reserved() {
	local sysfs led
	config_get sysfs "$1" sysfs
	for led in $RC01_RGB_LEDS; do
		[ "$sysfs" != "$led" ] || RC01_RGB_RESERVED=1
	done
	return 0
}

rc01_rgb_system_owned() {
	RC01_RGB_RESERVED=0
	config_load system
	config_foreach rc01_rgb_reserved led
	[ "$RC01_RGB_RESERVED" = 1 ]
}

# Another controller's active trigger on any channel keeps the whole bar.
rc01_rgb_triggered() {
	local led trigger
	for led in $RC01_RGB_LEDS; do
		trigger="$(cat "$RC01_RGB_SYSFS/class/leds/$led/trigger" 2>/dev/null)"
		case "$trigger" in ''|none|*'[none]'*) ;; *) return 0 ;; esac
	done
	return 1
}

rc01_rgb_off() {
	local led
	for led in $RC01_RGB_LEDS; do
		[ -w "$RC01_RGB_SYSFS/class/leds/$led/brightness" ] &&
			echo 0 > "$RC01_RGB_SYSFS/class/leds/$led/brightness"
	done
	return 0
}

start_service() {
	local enabled led
	config_load rc01_rgb
	config_get_bool enabled main enabled 0
	[ "$enabled" = 1 ] || return 0
	[ "$(uci -q get system.@system[-1].leds_off)" = 1 ] && return 0
	! rc01_rgb_system_owned || {
		logger -t rc01-rgb 'RGB LED configured in system; leaving it alone'
		return 0
	}
	for led in $RC01_RGB_LEDS; do
		[ -e "$RC01_RGB_SYSFS/class/leds/$led/brightness" ] || {
			logger -t rc01-rgb "LED $led not found; RGB service not started"
			return 0
		}
	done
	procd_open_instance
	procd_set_param command /usr/libexec/rc01-rgb
	# Settings are read at start: a changed config restarts the instance.
	procd_set_param file /etc/config/rc01_rgb
	procd_set_param respawn 3600 5 5
	procd_set_param stderr 1
	procd_close_instance
}

# procd has already asked the instance to stop; it turns off the channels
# it still owns and removes its status file, as it does when it yields the
# bar to another controller. A status file left behind therefore means the
# instance was killed while driving the bar: only then turn it off here,
# unless a system LED section or an active trigger now owns a channel.
service_stopped() {
	[ -e "$RC01_RGB_STATUS" ] || return 0
	rm -f "$RC01_RGB_STATUS"
	rc01_rgb_system_owned || rc01_rgb_triggered || rc01_rgb_off
}

service_triggers() {
	procd_add_reload_trigger rc01_rgb system
}
