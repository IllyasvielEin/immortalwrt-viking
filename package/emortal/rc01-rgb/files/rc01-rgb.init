#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-or-later

# Runs the RGB service only when rc01_rgb.main.enabled=1 (default 0) and
# system leds_off is not set. It then owns red/green/blue:ambient; no other
# LED is touched. Disabled, stopped or crashed for good, the bar is off.
# Starts after /etc/init.d/led (START=96).
START=97
STOP=10
USE_PROCD=1

RC01_RGB_LEDS="red:ambient green:ambient blue:ambient"
RC01_RGB_SYSFS="${RC01_SYSFS:-/sys}"

rc01_rgb_off() {
	local led
	for led in $RC01_RGB_LEDS; do
		[ -w "$RC01_RGB_SYSFS/class/leds/$led/brightness" ] &&
			echo 0 > "$RC01_RGB_SYSFS/class/leds/$led/brightness"
	done
	return 0
}

start_service() {
	local enabled led
	config_load rc01_rgb
	config_get_bool enabled main enabled 0
	[ "$enabled" = 1 ] || return 0
	[ "$(uci -q get system.@system[-1].leds_off)" = 1 ] && return 0
	for led in $RC01_RGB_LEDS; do
		[ -e "$RC01_RGB_SYSFS/class/leds/$led/brightness" ] || {
			logger -t rc01-rgb "LED $led not found; RGB service not started"
			return 0
		}
	done
	procd_open_instance
	procd_set_param command /usr/libexec/rc01-rgb
	# Settings are read at start: a changed config restarts the instance.
	procd_set_param file /etc/config/rc01_rgb
	procd_set_param respawn 3600 5 5
	procd_set_param stderr 1
	procd_close_instance
}

# procd has already asked the instance to stop; it turns the bar off
# itself, this covers an instance that was killed or never came up.
service_stopped() {
	rc01_rgb_off
}

service_triggers() {
	procd_add_reload_trigger rc01_rgb system
}
