# See /etc/init.d/rc01-rgb. Off by default: the RGB wiring is taken from a
# public reference and has not been measured on this board.
config rgb 'main'
	option enabled '0'
	option mode 'static'
	option color '#0066ff'
	option second_color '#ff00aa'
	option brightness '96'
	option minimum_brightness '8'
	option speed '5'
	option sensitivity '5'
	option traffic_interface 'wan'
	option schedule_enabled '0'
	option on_time '07:00'
	option off_time '23:30'
	option night_enabled '0'
	option night_start '22:00'
	option night_end '07:00'
	option night_brightness '24'
