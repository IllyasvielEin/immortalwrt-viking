msgstr "配置状态不能证明射频实际是否正在发射。"

msgid "Not included in this build"
msgstr "本次构建未选入"

msgid "Requires Xiaomi RC01 / BE10000"
msgstr "需要小米 RC01 / BE10000"

msgid "Requires the verified 120 MiB NAND layout"
msgstr "需要已核实的 120 MiB NAND 分区布局"

msgid "Requires the 64 KiB environment map; CRC is checked separately during upgrade"
msgstr "需要 64 KiB 环境映射；CRC 在升级前单独校验"

msgid "Requires kernel/rootfs/rootfs_data at UBI0 IDs 0/1/2"
msgstr "UBI0 的 0/1/2 号卷应为 kernel/rootfs/rootfs_data"

msgid "NAND uncorrectable ECC counter"
msgstr "NAND 不可纠正 ECC 计数"

msgid "Requires one healthy EMC2301 at address 0x2f"
msgstr "需要唯一且运行正常的 0x2f EMC2301 风扇控制器"

msgid "Requires a valid NSS temperature below the 75 C guard threshold"
msgstr "需要有效的 NSS 温度，且低于 75℃ 保护阈值"

msgid "Requires lan1..lan4, sfp and wan net devices; cables may be disconnected"
msgstr "需要 lan1..lan4、sfp、wan 网络设备；允许未插网线"

msgid "Native PPE module presence; zero or unavailable counters do not prove a fault"
msgstr "检查原生 PPE 模块；计数为零或不可读不代表驱动故障"

msgid "Run only one transparent proxy at a time"
msgstr "同一时间只运行一个透明代理"

msgid "Requested proxy core is installed"
msgstr "所选代理核心存在且可执行"

msgid "Stop and disable the other proxy before switching"
msgstr "切换前应停止并禁用另一个代理"

msgid "Bypass networking should remain manually managed"
msgstr "旁路由网络应保持手动管理"

msgid "Validate the proxy with flow offload disabled before testing acceleration coexistence"
msgstr "先在关闭 flow offload 的条件下验证代理，再测试与加速共存"

msgid "dae/daed requires runtime kernel BTF"
msgstr "dae/daed 需要运行内核提供 BTF"

msgid "Read-only preflight does not test DNS, routing, TCP/UDP, IPv6 or leak protection"
msgstr "只读预检未测试 DNS、路由、TCP/UDP、IPv6 或防泄漏"
