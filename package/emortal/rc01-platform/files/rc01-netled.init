#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-only

# Egress ICMP reachability on the front network LEDs (white/amber).
# Off by default: uci set rc01_netled.main.enabled=1 && uci commit rc01_netled
# A system LED section naming one of these LEDs keeps it under
# /etc/init.d/led; the service then leaves that LED alone. Every setting is
# part of the command line, so a changed configuration restarts the process
# on reload and no earlier result is carried over.
START=97
STOP=10
USE_PROCD=1

NETLED_BIN=/usr/libexec/rc01-netled
NETLED_WHITE=white:network
NETLED_AMBER=amber:network

rc01_netled_claim() {
	local sysfs
	config_get sysfs "$1" sysfs
	[ "$sysfs" = "$NETLED_WHITE" ] && NETLED_WHITE=
	[ "$sysfs" = "$NETLED_AMBER" ] && NETLED_AMBER=
	return 0
}

rc01_netled_arg() {
	NETLED_ARGS="$NETLED_ARGS$1
"
}

rc01_netled_target4() { rc01_netled_arg "ipv4_target=$1"; }
rc01_netled_target6() { rc01_netled_arg "ipv6_target=$1"; }

start_service() {
	local enabled value option IFS errors
	case "$(board_name)" in
	xiaomi,be10000|xiaomi,be10000-es) ;;
	*) return 0 ;;
	esac
	config_load system
	config_foreach rc01_netled_claim led
	[ "$(uci -q get system.@system[-1].leds_off)" = 1 ] && NETLED_WHITE= NETLED_AMBER=

	config_load rc01_netled
	config_get_bool enabled main enabled 0
	[ "$enabled" = 1 ] || return 0
	NETLED_ARGS=
	config_get_bool value main ipv4 1
	rc01_netled_arg "ipv4=$value"
	config_get_bool value main ipv6 1
	rc01_netled_arg "ipv6=$value"
	config_list_foreach main ipv4_target rc01_netled_target4
	config_list_foreach main ipv6_target rc01_netled_target6
	for option in ipv4_interface:auto ipv6_interface:auto interval:30 timeout:2 fail_count:3 recover_count:2; do
		config_get value main "${option%%:*}" "${option#*:}"
		rc01_netled_arg "${option%%:*}=$value"
	done
	rc01_netled_arg "led_white=$NETLED_WHITE"
	rc01_netled_arg "led_amber=$NETLED_AMBER"

	# One argument per line; a value containing a newline only splits into
	# arguments that fail validation.
	IFS='
'
	set -f
	set -- $NETLED_ARGS
	set +f
	unset IFS
	errors="$("$NETLED_BIN" check "$@" 2>&1)" || {
		printf '%s\n' "$errors" | logger -t rc01-netled
		logger -t rc01-netled "invalid configuration; not started"
		return 1
	}
	procd_open_instance
	procd_set_param command "$NETLED_BIN" run "$@"
	procd_set_param respawn 3600 5 5
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger rc01_netled system
}
