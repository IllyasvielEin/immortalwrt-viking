#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-only

START=11
STOP=89
USE_PROCD=1

start_service() {
	[ "$(board_name)" = "xiaomi,be10000" ] || return 0
	procd_open_instance
	procd_set_param command /usr/libexec/rc01-fan-guard
	procd_set_param respawn 3600 5 5
	procd_set_param stderr 1
	procd_close_instance
}
