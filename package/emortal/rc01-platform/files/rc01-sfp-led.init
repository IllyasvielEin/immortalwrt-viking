#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-only

# Opt-in: uci set system.led_sfp.rc01_presence=1 && uci commit system
# The service then owns the SFP LED; without the option /etc/init.d/led
# keeps the default netdev link/tx/rx policy and nothing runs here.
# Runs after /etc/init.d/led (START=96) has applied that policy.
START=97
STOP=10
USE_PROCD=1

start_service() {
	local enabled sysfs trigger dev mode interval
	case "$(board_name)" in
	xiaomi,be10000|xiaomi,be10000-es) ;;
	*) return 0 ;;
	esac
	[ "$(uci -q get system.@system[-1].leds_off)" = 1 ] && return 0
	config_load system
	config_get_bool enabled led_sfp rc01_presence 0
	[ "$enabled" = 1 ] || return 0
	config_get sysfs led_sfp sysfs
	config_get trigger led_sfp trigger
	config_get dev led_sfp dev
	config_get mode led_sfp mode
	config_get interval led_sfp interval 50
	# Only extend the netdev policy; another trigger is the user's choice.
	[ "$trigger" = netdev ] && [ -n "$sysfs" ] && [ -n "$dev" ] || {
		logger -t rc01-sfp-led "system.led_sfp is not a netdev LED; presence mode not started"
		return 0
	}
	procd_open_instance
	procd_set_param command /usr/libexec/rc01-sfp-led "$sysfs" "$dev" "$interval" $mode
	procd_set_param respawn 3600 5 5
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger system
}
