
# Egress ICMP reachability on the front network LEDs. Off by default.
# Default targets are public anycast DNS resolvers that answer ICMP echo:
# 223.5.5.5 / 2400:3200::1 (AliDNS) and 119.29.29.29 / 2402:4e00:: (DNSPod).
# Replace them with any 1..3 unicast addresses per family.
config netled 'main'
	option enabled '0'
	option ipv4 '1'
	option ipv6 '1'
	list ipv4_target '223.5.5.5'
	list ipv4_target '119.29.29.29'
	list ipv6_target '2400:3200::1'
	list ipv6_target '2402:4e00::'
	option ipv4_interface 'auto'
	option ipv6_interface 'auto'
	option interval '30'
	option timeout '2'
	option fail_count '3'
	option recover_count '2'
