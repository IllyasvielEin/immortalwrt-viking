#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
. /lib/functions.sh
[ "$(board_name)" = xiaomi,be10000 ] || exit 0

# Obtain the LAN management address from the upstream DHCP server.
# Keep the LAN DHCP server and unattended proxy/VPN services disabled.
uci -q batch <<'EOF'
set router-tool.main=settings
set router-tool.main.auto_network='0'
set network.lan.proto='dhcp'
set network.lan.device='br-lan'
delete network.lan.ipaddr
delete network.lan.netmask
delete network.lan.gateway
delete network.lan.dns
set network.lan.hostname='RC01'
set system.@system[0].hostname='RC01'
delete network.lan.ip6assign
delete network.lan.ip6hint
set network.lan.delegate='0'
set network.wan.auto='0'
set network.wan6.auto='0'
set dhcp.lan.ignore='1'
set dhcp.lan.dhcpv4='disabled'
set dhcp.lan.ra='disabled'
set dhcp.lan.dhcpv6='disabled'
set dhcp.lan.ndp='disabled'
set dhcp.@dnsmasq[0].cachesize='8192'
set dhcp.@dnsmasq[0].ednspacket_max='1232'
set dhcp.@dnsmasq[0].localservice='1'
delete dhcp.@dnsmasq[0].min_cache_ttl
delete dhcp.@dnsmasq[0].use_stale_cache
set dhcp.@dnsmasq[0].nonegcache='0'
set dhcp.@dnsmasq[0].dns_redirect='0'
set tailscale.settings=settings
set tailscale.settings.service_enabled='0'
delete uhttpd.main.listen_https
add_list uhttpd.main.listen_https='0.0.0.0:443'
add_list uhttpd.main.listen_https='[::]:443'
set uhttpd.main.redirect_https='0'
set uhttpd.defaults.commonname='RC01'
commit router-tool
commit network
commit dhcp
commit system
commit tailscale
commit uhttpd
EOF

# The board defaults already bridge lan1..lan4 and sfp, reserving wan (10G RJ45).
# Keep LAN forwarding but do not impose whole-LAN SNAT before proxy validation.
config_load firewall
rc01_lan_zone() {
	local name
	config_get name "$1" name
	[ "$name" = lan ] || return 0
	uci set "firewall.$1.forward=ACCEPT"
	uci set "firewall.$1.masq=0"
}
config_foreach rc01_lan_zone zone
uci commit firewall

# Installed for later use, with no unattended VPN/proxy startup.
for service in tailscale tailscale-settings; do
	[ ! -x "/etc/init.d/$service" ] || "/etc/init.d/$service" disable
done
if [ -x /etc/init.d/dae ]; then
	uci -q set dae.config.enabled='0'
	uci -q set daede.config.active_backend='dae'
	uci -q commit dae
	uci -q commit daede
fi
exit 0
