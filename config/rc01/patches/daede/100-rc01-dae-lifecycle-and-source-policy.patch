diff --git a/dae/files/dae-guard b/dae/files/dae-guard
new file mode 100644
index 0000000..ee6af8f
--- /dev/null
+++ b/dae/files/dae-guard
@@ -0,0 +1,109 @@
+#!/bin/sh
+# SPDX-License-Identifier: AGPL-3.0-only
+# RC01 lifecycle guard. Signal/reap ordering follows kenzok8/openwrt-daede's
+# daed-guard at 1eedcafd1cd4d8a89ac928be6608df76ffb38f78.
+# dae owns TC/BPF detach. Never remove shared BPF pins or unrelated links.
+
+dae_guard_cleanup() {
+	local rc namespaces links pid pids
+	# Refuse a second proxy instance or cleanup while another core is alive.
+	pidof dae daed mihomo >/dev/null 2>&1
+	rc=$?
+	case "$rc" in
+		0) logger -t dae-init 'another proxy is running; leaving runtime state untouched'; return 1 ;;
+		1) ;;
+		*) logger -t dae-init 'cannot verify proxy processes; refusing cleanup'; return 1 ;;
+	esac
+	namespaces=$(ip netns list) || return 1
+	links=$(ip -o link show) || return 1
+	if printf '%s\n' "$namespaces" | grep -Eq '^daens([[:space:]]|$)'; then
+		# No userspace core is alive. Only reap the reserved dae namespace.
+		pids=$(ip netns pids daens) || return 1
+		for pid in $pids; do
+			case "$pid" in ''|*[!0-9]*|0|1) return 1 ;; esac
+			kill "$pid" 2>/dev/null || true
+		done
+		pids=$(ip netns pids daens) || return 1
+		if [ -n "$pids" ]; then
+			sleep 1
+			pids=$(ip netns pids daens) || return 1
+			for pid in $pids; do
+				case "$pid" in ''|*[!0-9]*|0|1) return 1 ;; esac
+				kill -9 "$pid" 2>/dev/null || true
+			done
+		fi
+		ip netns del daens || return 1
+	fi
+	if printf '%s\n' "$links" | grep -Eq '^[0-9]+: dae0(@[^:]+)?:'; then
+		ip link del dae0 || return 1
+	fi
+}
+
+dae_guard_main() {
+	dae_guard_cleanup || return 1
+	child_pid=
+	pending_signal=
+	shutdown_signal=
+	shutdown_elapsed=0
+	forced_kill=0
+	child_term_timeout=20
+
+	forward_signal() {
+		local sig="$1"
+		if [ -z "$child_pid" ]; then
+			pending_signal="$sig"
+			return
+		fi
+		case "$sig" in
+			TERM|INT|QUIT)
+				if [ -z "$shutdown_signal" ]; then
+					shutdown_signal="$sig"
+					shutdown_elapsed=0
+				fi ;;
+		esac
+		kill -"$sig" "$child_pid" 2>/dev/null || true
+	}
+	child_is_running() {
+		local state
+		kill -0 "$child_pid" 2>/dev/null || return 1
+		state=$(awk '{ print $3 }' "/proc/$child_pid/stat" 2>/dev/null)
+		[ "$state" != Z ]
+	}
+	trap 'forward_signal TERM' TERM
+	trap 'forward_signal INT' INT
+	trap 'forward_signal HUP' HUP
+	trap 'forward_signal QUIT' QUIT
+	if [ -n "$pending_signal" ]; then
+		trap - TERM INT HUP QUIT
+		return 1
+	fi
+	"${DAE_GUARD_PROGRAM:-/usr/bin/dae}" "$@" &
+	child_pid=$!
+	if [ -n "$pending_signal" ]; then
+		forward_signal "$pending_signal"
+	fi
+	local status=0 cleanup_status=0
+	while :; do
+		if [ -n "$shutdown_signal" ] && child_is_running; then
+			if [ "$shutdown_elapsed" -ge "$child_term_timeout" ] && [ "$forced_kill" -eq 0 ]; then
+				logger -t dae-init 'core did not exit within 20s; killing it; TC/BPF state needs inspection'
+				kill -KILL "$child_pid" 2>/dev/null || true
+				forced_kill=1
+			fi
+			sleep 1
+			shutdown_elapsed=$((shutdown_elapsed + 1))
+			continue
+		fi
+		wait "$child_pid" 2>/dev/null
+		status=$?
+		child_is_running || break
+	done
+	child_pid=
+	trap - TERM INT HUP QUIT
+	# Cleanup happens only after wait has reaped the core, before procd respawn.
+	dae_guard_cleanup || cleanup_status=$?
+	[ "$status" -eq 0 ] || return "$status"
+	return "$cleanup_status"
+}
+
+[ "${DAE_GUARD_LIBRARY:-0}" = 1 ] || dae_guard_main "$@"
diff --git a/dae/files/dae.init b/dae/files/dae.init
index 394897e..44d179d 100644
--- a/dae/files/dae.init
+++ b/dae/files/dae.init
@@ -28,7 +28,7 @@ start_service() {
 
 	procd_open_instance "$CONF"
 	procd_set_param env DAE_LOCATION_ASSET="/usr/share/v2ray" TZ="$(uci -q get system.@system[0].zonename)"
-	procd_set_param command "$PROG" run
+	procd_set_param command /usr/bin/dae-guard run
 	procd_append_param command --config "$config_file"
 	procd_append_param command --logfile "$LOG_DIR/dae.log"
 	procd_append_param command --logfile-maxbackups "$log_maxbackups"
@@ -36,28 +36,17 @@ start_service() {
 
 	procd_set_param limits core="unlimited"
 	procd_set_param limits nofile="1000000 1000000"
-	procd_set_param respawn
+	procd_set_param term_timeout 30
+	procd_set_param respawn 3600 5 5
 	# procd_set_param stdout 1
 	procd_set_param stderr 1
 
 	procd_close_instance
 }
 
+# procd terminates the guard; it forwards TERM and waits before cleanup.
 stop_service() {
-	rm -rf "$LOG_DIR"
-	# kill lingering procs in daens: TERM first, then KILL for stubborn ones
-	for pid in $(ip netns pids daens 2>/dev/null); do kill "$pid" 2>/dev/null; done
-	if [ -n "$(ip netns pids daens 2>/dev/null)" ]; then
-		sleep 1
-		for pid in $(ip netns pids daens 2>/dev/null); do kill -9 "$pid" 2>/dev/null; done
-	fi
-	# cleanup daens netns; ip-full needed for netns, busybox fallback via umount
-	if ! ip netns del daens 2>/dev/null; then
-		umount /run/netns/daens 2>/dev/null
-		rm -f /run/netns/daens
-	fi
-	# clean orphaned dae0
-	ip link del dae0 2>/dev/null || true
+	:
 }
 
 service_triggers() {
